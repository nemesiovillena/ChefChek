# Database
DATABASE_URL="postgresql://user:password@localhost:5432/chefchek?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Auth
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# App
APP_NAME=ChefChek
APP_URL=http://localhost:3000

# Google Cloud Vision API
GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key-here

# Google Custom Search (búsqueda de imagen de artículos) — crear en
# https://programmablesearchengine.google.com/ (activar "Image search")
# y habilitar "Custom Search API" en Google Cloud Console
GOOGLE_CSE_API_KEY=your-google-custom-search-api-key-here
GOOGLE_CSE_ENGINE_ID=your-search-engine-id-here

# OCR Configuration
OCR_PROVIDER=google
OCR_MIN_CONFIDENCE=70
OCR_ENABLE_FALLBACK=true
# Clave para cifrar credenciales guardadas en BD (SMTP de Compras). Genera una aleatoria: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=
