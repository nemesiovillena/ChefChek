# Database
DATABASE_URL="postgresql://user:password@localhost:5432/chefchek?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Auth
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# App
APP_NAME=ChefChek
APP_URL=http://localhost:3000

# Google Cloud Vision API
GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key-here

# Pexels (búsqueda de imagen de artículos) — key gratis en https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# OCR Configuration
OCR_PROVIDER=google
OCR_MIN_CONFIDENCE=70
OCR_ENABLE_FALLBACK=true
# Clave para cifrar credenciales guardadas en BD (SMTP de Compras). Genera una aleatoria: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# ── Bunny.net Storage ──────────────────────────────────────────────────────────
# Imágenes subidas (avatares, recetas, artículos, fotos de incidencia) → Storage
# Zone con Pull Zone conectada. En dev, si estas 3 faltan, se cae a disco local
# (`uploads/`); en producción son OBLIGATORIAS (el arranque falla sin ellas).
BUNNY_STORAGE_ZONE=chefchek
BUNNY_STORAGE_PASSWORD=
BUNNY_CDN_URL=https://chefchek.b-cdn.net
# Backups (exports JSON de BD) → Storage Zone SEPARADA y SIN Pull Zone.
BUNNY_BACKUP_STORAGE_ZONE=chefchek-backups
BUNNY_BACKUP_STORAGE_PASSWORD=
# Opcional: host de la Storage API si la zona es regional (p.ej. de.storage.bunnycdn.com).
# BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
